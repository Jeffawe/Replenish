# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (in any folder, e.g. cloudflare/email-worker)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# saved OCR text of real receipts (scripts/try-receipt.ts)
/.cache/

# Cloudflare Wrangler
.wrangler/
.dev.vars*
